 <HET_I2O4_AJ> I2O4 = 2.00000*DUMMY   : KHETERO( IK_HETERO_I2O4_AJ ) ;
 <HET_SO2_H2O2> SO2 + H2O2 = ASO4J  : KHETERO( IK_HETERO_SO2H ) ;
 <HET_SO2_O3> SO2 + O3 = ASO4J  : KHETERO( IK_HETERO_SO2O ) ;
 <HET_SO2_MEPX> SO2 + OP1 = ASO4J + MOH  : KHETERO( IK_HETERO_SO2M ) ;
 <HET_SO2_PACD> SO2 + PAA = ASO4J + ORA2  : KHETERO( IK_HETERO_SO2P ) ;
 <HET_SO2_NO2> SO2 + NO2 = ASO4J + HONO  : KHETERO( IK_HETERO_SO2N ) ;
 <HET_SO2_TMI> SO2 + AFEJ + AMNJ = ASO4J + AFEJ + AMNJ  : KHETERO( IK_HETERO_SO2T ) ;
 <HET_SO2_HCHO> SO2 + HCHO = AHMSJ  : KHETERO( IK_HETERO_HMSP ) ;
 <HET_SO2_HNO4> SO2 + HNO4 = ASO4J + ANO3J  : KHETERO( IK_HETERO_HMSP ) ;
 <HET_HMS_L1> AHMSJ + HO = HO2 + SO2 + ORA1  : KHETERO( IK_HETERO_HMSP ) ;
 <HET_HMS_L2> AHMSJ = SO2 + HCHO  : KHETERO( IK_HETERO_HMSP ) ;

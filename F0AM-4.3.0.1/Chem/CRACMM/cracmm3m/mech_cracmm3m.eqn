#EQNTAGS ON
#EQUATIONS
// All rate constants converted from  molec/cm3 to ppm
// and 1/sec to 1/min
 <R001> O3 = O3P  : RJCELL( IJ_O3O3P_NASA06 ) ;
 <R002> O3 = O1D  : RJCELL( IJ_O3O1D_NASA06 ) ;
 <R003> H2O2 = 2.00000*HO  : RJCELL( IJ_H2O2_RACM2 ) ;
 <R004> NO2 = O3P + NO  : RJCELL( IJ_NO2_RACM2 ) ;
 <R005> NO3 = NO  : RJCELL( IJ_NO3NO_RACM2 ) ;
 <R006> NO3 = O3P + NO2  : RJCELL( IJ_NO3NO2_RACM2 ) ;
 <R007> HONO = HO + NO  : RJCELL( IJ_HONO_RACM2 ) ;
 <R008> HNO3 = HO + NO2  : RJCELL( IJ_HNO3_RACM2 ) ;
 <R009> HNO4 = 0.20000*HO +  0.80000*HO2 +  0.80000*NO2 +  0.20000*NO3  : RJCELL( IJ_HNO4_RACM2 ) ;
 <R010> HCHO = CO  : RJCELL( IJ_HCHO_MOL_JPL19 ) ;
 <R011> HCHO = 2.00000*HO2 + CO  : RJCELL( IJ_HCHO_RAD_JPL19 ) ;
 <R012> ACD = HO2 + MO2 + CO  : RJCELL( IJ_CH3CHO_RACM2 ) ;
 <R013> ALD = HO2 + ETHP + CO  : RJCELL( IJ_ALD_JPL19 ) ;
 <R014> ACT = MO2 + ACO3  : RJCELL( IJ_CH3COCH3A_JPL19 ) ;
 <R014a> ACT = 2.00000*MO2 + CO  : RJCELL( IJ_CH3COCH3B_JPL19 ) ;
 <R015> UALD = 1.22000*HO2 +  0.78400*ACO3 +  1.22000*CO +  0.35000*HCHO +  0.43400*ALD 
  
                +  0.21600*KET  : RJCELL( IJ_UALD_RACM2 ) ;
 <TRP01> PINAL = HO2 + PINALP + CO  : RJCELL( IJ_ALD_JPL19 ) ;
 <TRP02> LIMAL = HO2 + LIMALP + CO  : RJCELL( IJ_ALD_JPL19 ) ;
 <R016> MEK = 0.10000*MO2 + ETHP +  0.90000*ACO3 +  0.10000*CO  : RJCELL( IJ_MEK_JGR19 ) ;
 <R017> KET = 1.50000*ETHP +  0.50000*ACO3 +  0.50000*CO  : RJCELL( IJ_KET_JGR19 ) ;
 <R018> HKET = HO2 + ACO3 + HCHO  : RJCELL( IJ_HKET_RACM2 ) ;
 <R019> MACR = 0.34000*HO +  0.66000*HO2 +  0.67000*ACO3 +  0.33000*MACP +  0.34000*XO2 
  
                +  0.67000*CO +  0.67000*HCHO  : RJCELL( IJ_MACR_RACM2 ) ;
 <R020> MVK = 0.30000*MO2 +  0.30000*MACP +  0.70000*CO +  0.70000*UALD  : RJCELL( IJ_MVK_JPL19 ) ;
 <R021> GLY = 2.00000*CO  : RJCELL( IJ_GLYH2_JPL19 ) ;
 <R022> GLY = HCHO + CO  : RJCELL( IJ_GLYF_JPL19 ) ;
 <R023> GLY = 2.00000*HO2 +  2.00000*CO  : RJCELL( IJ_GLYHX_JPL19 ) ;
 <R024> MGLY = HO2 + ACO3 + CO  : RJCELL( IJ_MGLY_RACM2 ) ;
 <R025> DCB1 = 1.50000*HO2 +  0.25000*ACO3 +  0.20000*XO2 + CO +  0.50000*GLY   
                +  0.50000*MGLY  : RJCELL( IJ_MGLY_RACM2 ) ;
 <R026> DCB2 = 1.50000*HO2 +  0.25000*ACO3 +  0.20000*XO2 + CO +  0.50000*GLY   
                +  0.50000*MGLY  : RJCELL( IJ_MGLY_RACM2 ) ;
 <R027a> BALD = BEN + CO  : RJCELL( IJ_BALD1_CALVERT11 ) ;
 <R027b> BALD = BAL1 + CO + HO2  : RJCELL( IJ_BALD2_CALVERT11 ) ;
 <R028> OP1 = HO + HO2 + HCHO  : RJCELL( IJ_OP1_RACM2 ) ;
 <R029> OP2 = HO + HO2 + ALD  : RJCELL( IJ_OP1_RACM2 ) ;
 <TRP03> OPB = HO + HO2 + ALD  : RJCELL( IJ_OP1_RACM2 ) ;
 <R029a> VOP3 = HO + HO2 + ALD  : RJCELL( IJ_OP1_RACM2 ) ;
 <R030> PAA = HO + MO2  : RJCELL( IJ_PAA_RACM2 ) ;
 <R031> ONIT = HO2 + NO2 +  0.20000*ALD +  0.80000*KET  : RJCELL( IJ_ONIT_CALVERT08 ) ;
 <R032> PAN = ACO3 + NO2  : RJCELL( IJ_PAN1_JPL19 ) ;
 <R033> PAN = MO2 + NO3 + CO2  : RJCELL( IJ_PAN2_JPL19 ) ;
 <R033a> PPN = RCO3 + NO2  : RJCELL( IJ_PPN1_JPL19 ) ;
 <R033b> PPN = HC3P + NO3  : RJCELL( IJ_PPN2_JPL19 ) ;
 <TRP55> VTRPN = NO2 +  0.67000*KET +  0.33000*UALD  : RJCELL( IJ_TRPN_WANG2023 ) ;
 <TRP56> VHONIT = HKET + NO2  : RJCELL( IJ_TRPN_WANG2023 ) ;
 <R034> O3 + HO = HO2  :  RFACTOR * ARR2D(   1.7000D-12,  -9.4000D+02 ) ;
 <R035> O3 + HO2 = HO  :  RFACTOR * ARR2D(   1.0000D-14,  -4.9000D+02 ) ;
 <R036> O3 + NO = NO2  :  RFACTOR * ARR2D(   3.0000D-12,  -1.5000D+03 ) ;
 <R037> O3 + NO2 = NO3  :  RFACTOR * ARR2D(   1.2000D-13,  -2.4500D+03 ) ;
 <R038> O3P + O2 + M = O3  :  RFACTOR_SQU * ARRD(   6.1000D-34, 0.0000D+0, -2.4000D+00 ) ;
 <R039> O3P + O3 = DUMMY   :  RFACTOR * ARR2D(   8.0000D-12,  -2.0600D+03 ) ;
 <R040> O1D + O2 = O3P  :  RFACTOR * ARR2D(   3.3000D-11,   5.5000D+01 ) ;
 <R041> O1D + N2 = O3P  :  RFACTOR * ARR2D(   2.1500D-11,   1.1000D+02 ) ;
 <R042> O1D + H2O = 2.00000*HO  :  RFACTOR * ARR2D(   1.6300D-10,   6.0000D+01 ) ;
 <R043> HO + H2 = HO2  :  RFACTOR * ARR2D(   2.8000D-12,  -1.8000D+03 ) ;
 <R044> HO + HO2 = DUMMY   :  RFACTOR * ARR2D(   4.8000D-11,   2.5000D+02 ) ;
 <R045> HO2 + HO2 = H2O2  :  RFACTOR * EP3D(   3.0000D-13,   4.6000D+02,   2.1000D-33,   9.2000D+02 ) ;
 <R046> HO2 + HO2 + H2O = H2O2  :  RFACTOR_SQU * EP3D(   4.2000D-34,   2.6600D+03,   2.9400D-54,   3.1200D+03 ) ;
 <R047> H2O2 + HO = HO2  :  RFACTOR * ARR2D(   1.8000D-12,   0.0000D+00 ) ;
 <R048> NO + O3P = NO2  :  RFACTOR * RKI_RXN_R048             ;
 <R049> NO + HO = HONO  :  RFACTOR * RKI_RXN_R049             ;
 <R050> NO + HO2 = NO2 + HO  :  RFACTOR * ARR2D(   3.4400D-12,   2.6000D+02 ) ;
 <R051> NO + HO2 = HNO3  :  RFACTOR * EP4D(   6.0950D-14,  -1.0000D+00,   2.7000D+02,   6.8570D-34,   1.0000D+00,   2.7000D+02,  -5.9680D-14,   2.7000D+02 ) ;
 <R052> NO + NO + O2 = 2.00000*NO2  :  RFACTOR_SQU * ARR2D(   4.2500D-39,   6.6350D+02 ) ;
 <R053> HONO + HO = NO2  :  RFACTOR * ARR2D(   3.0000D-12,   2.5000D+02 ) ;
 <R054> NO2 + O3P = NO  :  RFACTOR * ARR2D(   5.3000D-12,   2.0000D+02 ) ;
 <R055> NO2 + O3P = NO3  :  RFACTOR * RKI_RXN_R055             ;
 <R056> NO2 + HO = HNO3  :  RFACTOR * RKI_RXN_R056             ;
 <R057> HNO3 + HO = NO3  :  RFACTOR * EP2D(   2.4000D-14,   4.6000D+02,   2.7000D-17,   2.1990D+03,   6.5000D-34,   1.3350D+03 ) ;
 <R058> NO3 + HO = HO2 + NO2  :  RFACTOR *   2.0000D-11 ;
 <R059> NO3 + HO2 = 0.70000*HO +  0.70000*NO2 +  0.30000*HNO3  :  RFACTOR *   3.5000D-12 ;
 <R060> NO3 + NO = 2.00000*NO2  :  RFACTOR * ARR2D(   1.7000D-11,   1.2500D+02 ) ;
 <R061> NO3 + NO2 = NO + NO2  :  RFACTOR * ARR2D(   4.3500D-14,  -1.3350D+03 ) ;
 <R062> NO3 + NO3 = 2.00000*NO2  :  RFACTOR * ARR2D(   8.5000D-13,  -2.4500D+03 ) ;
 <R063> NO3 + NO2 = N2O5  :  RFACTOR * RKI_RXN_R063             ;
 <R064> N2O5 = NO2 + NO3  :  ( 60.0D0 / RFACTOR ) * RCONST(   73 ) / ARR2(   5.8000D-27,   1.0840D+04 ) ;
 <R065> N2O5 + H2O = 2.00000*HNO3  :  RFACTOR *   1.0000D-22 ;
 <R066> NO2 + HO2 = HNO4  :  RFACTOR * RKI_RXN_R066             ;
 <R067> HNO4 = HO2 + NO2  :  ( 60.0D0 / RFACTOR ) * RCONST(   76 ) / ARR2(   2.1000D-27,   1.0900D+04 ) ;
 <R068> HNO4 + HO = NO2  :  RFACTOR * ARR2D(   4.5000D-13,   6.1000D+02 ) ;
 <R069> SO2 + HO = HO2 + SULF + SULRXN  :  RFACTOR * RKI_RXN_R069             ;
 <R070> CO + HO = HO2 + CO2  :  RFACTOR * EP3D(   1.4400D-13,   0.0000D+00,   2.7400D-33,   0.0000D+00 ) ;
 <R071> HO + CH4 = MO2  :  RFACTOR * ARR2D(   2.4500D-12,  -1.7750D+03 ) ;
 <R072> ETH + HO = ETHP  :  RFACTOR * ARR2D(   7.6600D-12,  -1.0200D+03 ) ;
 <R073> HC3 + HO = HC3P +  0.00003*ASOATJ  :  RFACTOR * ARR2D(   7.6800D-12,  -3.7000D+02 ) ;
 <R074> HC5 + HO = HC5P +  0.00134*ASOATJ  :  RFACTOR * ARR2D(   1.0100D-11,  -2.4500D+02 ) ;
 <R076> ETE + HO = ETEP  :  RFACTOR * RKI_RXN_R076             ;
 <R077> OLT + HO = OLTP  :  RFACTOR * ARR2D(   5.7200D-12,   5.0000D+02 ) ;
 <R078> OLI + HO = OLIP  :  RFACTOR * ARR2D(   1.3300D-11,   5.0000D+02 ) ;
 <R080> ACE + HO = 0.65000*HO +  0.35000*HO2 +  0.35000*CO +  0.65000*GLY +  0.35000*ORA1  :  RFACTOR * RKI_RXN_R080             ;
 <ROCARO31> BEN + HO = 0.47000*BENP +  0.53000*PHEN +  0.53000*HO2  :  RFACTOR * ARR2D(   2.3300D-12,  -1.9300D+02 ) ;
 <ROCARO41> TOL + HO = 0.82000*TOLP +  0.18000*CSL +  0.18000*HO2  :  RFACTOR * ARR2D(   1.8100D-12,   3.5400D+02 ) ;
 <ROCARO51> XYL + HO = 0.83000*XYLP +  0.17000*CSL +  0.17000*HO2  :  RFACTOR *   2.3300D-11 ;
 <ROCARO61> EBZ + HO = 0.82000*EBZP +  0.18000*CSL +  0.18000*HO2  :  RFACTOR *   7.0000D-12 ;
 <ROCARO61a> EBZ + NO3 = EBZP + HNO3  :  RFACTOR *   5.7000D-16 ;
 <RAM01> ISO + O3 = 0.25000*HO +  0.25000*HO2 +  0.40000*MO2 +  0.01800*ACO3 +  0.10000*MACP 
  
                +  0.09000*H2O2 +  0.22000*CO + HCHO +  0.30000*MACR +  0.14000*MVK +  0.28000*ORA1 
  
                +  0.15300*OLT  :  RFACTOR * ARR2D(   1.5800D-14,  -2.0000D+03 ) ;
 <RAM02> ISO + NO3 = 0.40000*NO2 +  0.04500*ISON +  0.35000*HCHO +  0.55500*ISONP +  0.26000*MVK 
  
                +  0.02800*MACR  :  RFACTOR * ARR2D(   2.9500D-12,  -4.5000D+02 ) ;
 <RAM03> ISO + HO = ISOP +  0.25000*HCHO +  0.03000*MACR +  0.05000*MGLY  :  RFACTOR * ARR2D(   2.6900D-11,   3.9000D+02 ) ;
 <RAM04> ISOP + HO2 = ISHP +  0.07000*HO2 +  0.50000*HO  :  RFACTOR * ARR2D(   4.5000D-13,   1.3000D+03 ) ;
 <RAM05> ISOP + NO = 0.13000*ISON +  0.40000*HCHO +  0.88000*HO2 +  0.87000*NO2 +  0.18000*MACR 
  
                +  0.51000*MVK  :  RFACTOR * ARR2D(   6.0000D-12,   3.5000D+02 ) ;
 <RAM06> ISHP + HO = ISOP  :  RFACTOR * ARR2D(   4.6000D-12,   2.0000D+02 ) ;
 <RAM07> ISHP + HO = 0.04000*MGLY +  0.02000*GLY +  0.13000*MVK +  0.44000*IEPOX +  0.11000*ACO3 
  
                +  0.03000*MACR +  2.00000*HO +  0.34000*HO2 +  0.14000*IPX + CO  :  RFACTOR * ARR2D(   2.9700D-11,   3.9000D+02 ) ;
 <RAM08> ISONP + HO2 = 0.45000*HO +  0.95000*INALD +  0.02000*IPX  :  RFACTOR * ARR2D(   3.1400D-11,   5.8000D+02 ) ;
 <RAM09> ISONP + NO = 0.15000*MVK +  0.65000*INALD +  0.05000*ISON +  0.20000*HCHO +  1.30000*NO2  :  RFACTOR * ARR2D(   9.4200D-12,   5.8000D+02 ) ;
 <RAM10> ISON + HO = HO +  0.35000*INALD +  0.17000*IEPOX +  0.65000*NO2  :  RFACTOR * ARR2D(   2.4000D-11,   3.9000D+02 ) ;
 <RAM11> HO + INALD = CO + NO2 +  0.30000*HO2 + HCHO  :  RFACTOR *   1.5000D-11 ;
 <RAM12> ISON = HNO3 + ROH  :  60.0D0 *   4.0000D-05 ;
 <RAM13> IPX + HO = 0.57000*MACR +  0.43000*MVK  :  RFACTOR *   3.0000D-12 ;
 <R087> API + HO = 0.97500*APIP1 +  0.02500*APIP2  :  RFACTOR * ARR2D(   1.2100D-11,   4.4000D+02 ) ;
 <R088> LIM + HO = 0.94500*LIMP1 +  0.05500*LIMP2  :  RFACTOR * ARR2D(   4.2000D-11,   4.0100D+02 ) ;
 <TRP04> PINAL + HO = 0.23000*PINALP +  0.77000*RCO3  :  RFACTOR * ARR2D(   5.2000D-12,   6.0000D+02 ) ;
 <TRP05> LIMAL + HO = 0.83000*LIMALP +  0.17000*RCO3  :  RFACTOR *   1.1000D-10 ;
 <R089> HCHO + HO = HO2 + CO  :  RFACTOR * ARR2D(   5.5000D-12,   1.2500D+02 ) ;
 <R090> ACD + HO = ACO3  :  RFACTOR * ARR2D(   4.7000D-12,   3.4500D+02 ) ;
 <R091> ALD + HO = RCO3  :  RFACTOR * ARR2D(   4.9000D-12,   4.0500D+02 ) ;
 <R092> ACT + HO = ACTP  :  RFACTOR * ARRD(   4.5600D-14,  -4.2700D+02,   3.6500D+00 ) ;
 <R093> MEK + HO = MEKP  :  RFACTOR * ARR2D(   1.5000D-12,  -9.0000D+01 ) ;
 <R094> KET + HO = KETP  :  RFACTOR * ARR2D(   2.8000D-12,   1.0000D+01 ) ;
 <R095> HKET + HO = HO2 + MGLY  :  RFACTOR *   3.0000D-12 ;
 <R096> MACR + HO = 0.57000*MACP +  0.43000*MCP  :  RFACTOR * ARR2D(   8.0000D-12,   3.8000D+02 ) ;
 <R097> MVK + HO = MVKP  :  RFACTOR * ARR2D(   2.6000D-12,   6.1000D+02 ) ;
 <R098> UALD + HO = 0.31300*ACO3 +  0.68700*UALP  :  RFACTOR * ARR2D(   5.7700D-12,   5.3300D+02 ) ;
 <R099> GLY + HO = HO2 +  2.00000*CO  :  RFACTOR *   1.1000D-11 ;
 <R100> MGLY + HO = ACO3 + CO  :  RFACTOR * ARR2D(   9.2600D-13,   8.3000D+02 ) ;
 <R101> DCB1 + HO = 0.52000*HO2 +  0.33000*CO +  0.40000*ALD +  0.78000*KET +  0.10000*GLY 
  
                +  0.01000*MGLY  :  RFACTOR * ARR2D(   2.8000D-11,   1.7500D+02 ) ;
 <R102> DCB2 + HO = 0.52000*HO2 +  0.33000*CO +  0.13000*MEK +  0.10000*GLY +  0.01000*MGLY 
  
                +  0.78000*OP2  :  RFACTOR * ARR2D(   2.8000D-11,   1.7500D+02 ) ;
